# Telegram API Credentials
# Get these from https://my.telegram.org
TELEGRAM_API_ID=your_api_id
TELEGRAM_API_HASH=your_api_hash
TELEGRAM_BOT_TOKEN=your_bot_token

# GitHub Configuration
# Create a Personal Access Token with repo scope
GITHUB_TOKEN=your_github_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=your_repository_name
GITHUB_BRANCH=main

# Channel Branding
# Your own Telegram channel information for public output
CHANNEL_NAME=My Channel Name
CHANNEL_USERNAME=@mychannel
CHANNEL_ID=123456789

# Admin Authorization
# Comma-separated list of Telegram user IDs allowed to use admin commands
ADMIN_USER_IDS=123456789,987654321

# Collection Settings
COLLECTION_INTERVAL_MINUTES=30
FIRST_RUN_MESSAGE_LIMIT=5000

# Document Processing
MAX_DOCUMENT_SIZE_MB=10.0

# Operational Settings
# Set to false for production GitHub publishing
DRY_RUN=true

# Logging
LOG_LEVEL=INFO

# Database
DATABASE_PATH=v2ray_aggregator.db

# Session
TELEGRAM_SESSION_NAME=v2ray_aggregator_session
